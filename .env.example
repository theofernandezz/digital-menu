# Local Supabase (`supabase start`) — run `supabase status -o env` for the
# values below. The local anon/service-role keys are fixed, public demo keys,
# not secrets. Production values live in .env.prod.local (gitignored).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Direct connection to the LOCAL Supabase database, used only by integration tests
# that need SQL the API can't do (DDL, catalog checks). The tests refuse any host
# other than localhost / 127.0.0.1 / host.docker.internal.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local admin created by supabase/seed.sql — used by the integration and e2e
# test suites (adapters/**/*.integration.test.ts, e2e/*.spec.ts) and by CI.
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=local-admin-password
